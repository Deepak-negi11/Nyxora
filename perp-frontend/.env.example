# Copy to .env.local and fill in. .env* files are git-ignored.

# Required for trading and live oracle prices. Server-only (no NEXT_PUBLIC_):
# the /api/hermes proxy adds it, so it never reaches the browser. Pyth Hermes
# needs a key since the Pyth Core upgrade (26 Aug 2026). Without it the UI shows
# an indicative Binance price and trades fail with a clear error.
PYTH_API_KEY=
# Optional: override the Hermes endpoint (e.g. https://pyth.dourolabs.app/hermes)
PYTH_HERMES_URL=

NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_ADMIN_WALLET=
